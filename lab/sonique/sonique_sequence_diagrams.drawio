<mxfile host="app.diagrams.net">
  <diagram name="SONIQUE_Seq_Audio_Classification" id="sonique_seq_01">
    <mxGraphModel dx="1400" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="SONIQUE — Sequence Diagram: Audio Recording &amp; Classification" style="text;html=1;fontSize=16;fontStyle=1;align=center;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="250" y="10" width="600" height="30" as="geometry" />
        </mxCell>

        <!-- ===== LIFELINES ===== -->
        <mxCell id="o_user" value=":User" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;size=40;" vertex="1" parent="1">
          <mxGeometry x="50" y="60" width="80" height="980" as="geometry" />
        </mxCell>

        <mxCell id="o_react" value=":React&#10;Frontend" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;size=40;" vertex="1" parent="1">
          <mxGeometry x="220" y="60" width="100" height="980" as="geometry" />
        </mxCell>

        <mxCell id="o_browser" value=":Browser&#10;APIs" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontStyle=1;size=40;" vertex="1" parent="1">
          <mxGeometry x="410" y="60" width="100" height="980" as="geometry" />
        </mxCell>

        <mxCell id="o_flask" value=":Flask&#10;Backend" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontStyle=1;size=40;" vertex="1" parent="1">
          <mxGeometry x="600" y="60" width="100" height="980" as="geometry" />
        </mxCell>

        <mxCell id="o_yamnet" value=":YAMNet&#10;Model" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;size=40;" vertex="1" parent="1">
          <mxGeometry x="800" y="60" width="100" height="980" as="geometry" />
        </mxCell>

        <mxCell id="o_db" value=":SQLite&#10;Database" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;size=40;" vertex="1" parent="1">
          <mxGeometry x="1000" y="60" width="100" height="980" as="geometry" />
        </mxCell>

        <mxCell id="o_osm" value=":OpenStreet&#10;Map" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;fontStyle=1;size=40;" vertex="1" parent="1">
          <mxGeometry x="1200" y="60" width="100" height="980" as="geometry" />
        </mxCell>

        <!-- ===== MESSAGES ===== -->

        <!-- 1. User clicks Record -->
        <mxCell id="m1" value="1: clickRecord()" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="90" y="150" as="sourcePoint" />
            <mxPoint x="265" y="150" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- 2. Frontend requests mic permission -->
        <mxCell id="m2" value="2: requestMicrophoneAccess()" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="270" y="200" as="sourcePoint" />
            <mxPoint x="455" y="200" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- 3. Browser grants stream -->
        <mxCell id="m3" value="3: return MediaStream" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="455" y="250" as="sourcePoint" />
            <mxPoint x="270" y="250" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- 4. Frontend requests geolocation -->
        <mxCell id="m4" value="4: getGeolocation()" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="270" y="300" as="sourcePoint" />
            <mxPoint x="455" y="300" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- 5. Browser returns GPS -->
        <mxCell id="m5" value="5: return {latitude, longitude}" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="455" y="350" as="sourcePoint" />
            <mxPoint x="270" y="350" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- 6. Frontend shows waveform -->
        <mxCell id="m6" value="6: displayWaveform(audioData)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="265" y="400" as="sourcePoint" />
            <mxPoint x="90" y="400" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- 7. Recording stops, Frontend uploads -->
        <mxCell id="m7" value="7: POST /upload (audioBlob, lat, lon)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="270" y="460" as="sourcePoint" />
            <mxPoint x="645" y="460" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- 8. Flask converts audio -->
        <mxCell id="m8" value="8: convertToWAV(webmFile)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="650" y="510" as="sourcePoint" />
            <mxPoint x="710" y="510" as="targetPoint" />
            <Array as="points">
              <mxPoint x="710" y="510" />
              <mxPoint x="710" y="540" />
              <mxPoint x="650" y="540" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- 9. Flask sends to YAMNet -->
        <mxCell id="m9" value="9: classify(waveform)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="650" y="580" as="sourcePoint" />
            <mxPoint x="845" y="580" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- 10. YAMNet returns predictions -->
        <mxCell id="m10" value="10: return {scores, embeddings}" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="845" y="630" as="sourcePoint" />
            <mxPoint x="650" y="630" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- 11. Flask extracts top 3 -->
        <mxCell id="m11" value="11: extractTop3Predictions(scores)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="650" y="680" as="sourcePoint" />
            <mxPoint x="710" y="680" as="targetPoint" />
            <Array as="points">
              <mxPoint x="710" y="680" />
              <mxPoint x="710" y="710" />
              <mxPoint x="650" y="710" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- 12. Flask stores in DB -->
        <mxCell id="m12" value="12: INSERT(label, confidence, lat, lon)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="650" y="750" as="sourcePoint" />
            <mxPoint x="1045" y="750" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- 13. DB confirms -->
        <mxCell id="m13" value="13: return recordId" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1045" y="800" as="sourcePoint" />
            <mxPoint x="650" y="800" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- 14. Flask returns results to frontend -->
        <mxCell id="m14" value="14: return {label, confidence, top3}" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="645" y="850" as="sourcePoint" />
            <mxPoint x="270" y="850" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- 15. Frontend requests map tiles -->
        <mxCell id="m15" value="15: requestTiles(lat, lon, zoom)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="270" y="900" as="sourcePoint" />
            <mxPoint x="1245" y="900" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- 16. OSM returns tiles -->
        <mxCell id="m16" value="16: return mapTileImages" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1245" y="940" as="sourcePoint" />
            <mxPoint x="270" y="940" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- 17. Frontend shows map with marker -->
        <mxCell id="m17" value="17: displayMapWithMarker(label, confidence, lat, lon)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="265" y="990" as="sourcePoint" />
            <mxPoint x="90" y="990" as="targetPoint" />
          </mxGeometry>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>

  <diagram name="SONIQUE_Seq_View_History" id="sonique_seq_02">
    <mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title2" value="SONIQUE — Sequence Diagram: View Sound History" style="text;html=1;fontSize=16;fontStyle=1;align=center;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="200" y="10" width="500" height="30" as="geometry" />
        </mxCell>

        <!-- Lifelines -->
        <mxCell id="h_user" value=":User" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;size=40;" vertex="1" parent="1">
          <mxGeometry x="50" y="60" width="80" height="580" as="geometry" />
        </mxCell>

        <mxCell id="h_react" value=":React Frontend" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;size=40;" vertex="1" parent="1">
          <mxGeometry x="250" y="60" width="120" height="580" as="geometry" />
        </mxCell>

        <mxCell id="h_flask" value=":Flask Backend" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontStyle=1;size=40;" vertex="1" parent="1">
          <mxGeometry x="480" y="60" width="120" height="580" as="geometry" />
        </mxCell>

        <mxCell id="h_db" value=":SQLite DB" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;size=40;" vertex="1" parent="1">
          <mxGeometry x="720" y="60" width="100" height="580" as="geometry" />
        </mxCell>

        <!-- Messages -->
        <mxCell id="hm1" value="1: navigateToHistory()" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="90" y="150" as="sourcePoint" />
            <mxPoint x="305" y="150" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="hm2" value="2: GET /history" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="310" y="210" as="sourcePoint" />
            <mxPoint x="535" y="210" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="hm3" value="3: SELECT * FROM sounds ORDER BY created_at DESC" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="540" y="270" as="sourcePoint" />
            <mxPoint x="765" y="270" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="hm4" value="4: return rows[]" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="765" y="330" as="sourcePoint" />
            <mxPoint x="540" y="330" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="hm5" value="5: return JSON historyList[]" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="535" y="390" as="sourcePoint" />
            <mxPoint x="310" y="390" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="hm6" value="6: displayHistoryList(records)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="305" y="450" as="sourcePoint" />
            <mxPoint x="90" y="450" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Optional filter -->
        <mxCell id="opt" value="opt [user applies filter]" style="shape=umlFrame;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;fontSize=11;fontStyle=1;width=150;height=20;" vertex="1" parent="1">
          <mxGeometry x="30" y="490" width="790" height="120" as="geometry" />
        </mxCell>

        <mxCell id="hm7" value="7: applyFilter(soundType)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="90" y="540" as="sourcePoint" />
            <mxPoint x="305" y="540" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="hm8" value="8: displayFilteredList(filtered)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="305" y="585" as="sourcePoint" />
            <mxPoint x="90" y="585" as="targetPoint" />
          </mxGeometry>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
