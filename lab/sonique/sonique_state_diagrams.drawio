          <mxGeometry x="780" y="120" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="sm_popup_act" value="entry / show label, confidence, date&#xa;do / highlight selected marker" style="text;html=0;fontSize=9;align=left;" vertex="1" parent="1">
          <mxGeometry x="785" y="182" width="200" height="25" as="geometry" />
        </mxCell>
        <!-- UPDATING -->
        <mxCell id="sm_update" value="UPDATING" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="780" y="280" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="sm_update_act" value="entry / new classification received&#xa;do / add new marker&#xa;do / refresh heatmap data" style="text;html=0;fontSize=9;align=left;" vertex="1" parent="1">
          <mxGeometry x="785" y="342" width="200" height="40" as="geometry" />
        </mxCell>
        <!-- Transitions -->
        <mxCell id="tm0" value="" style="endArrow=block;endFill=1;html=1;" edge="1" parent="1" source="i2" target="sm_load">
