          <mxGeometry x="480" y="120" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="sm_markers_act" value="entry / load all sound records&#xa;do / place colour-coded markers&#xa;do / bind popup events" style="text;html=0;fontSize=9;align=left;" vertex="1" parent="1">
          <mxGeometry x="485" y="182" width="200" height="40" as="geometry" />
        </mxCell>
        <!-- HEATMAP VIEW -->
