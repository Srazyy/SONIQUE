        <!-- LOADING MAP -->
        <mxCell id="sm_load" value="LOADING MAP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="200" y="180" width="160" height="60" as="geometry" />
