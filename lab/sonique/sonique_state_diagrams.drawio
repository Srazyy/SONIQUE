          <mxGeometry x="480" y="280" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="sm_heat_act" value="entry / calculate intensity values&#xa;do / render heatmap overlay&#xa;do / hide individual markers" style="text;html=0;fontSize=9;align=left;" vertex="1" parent="1">
          <mxGeometry x="485" y="342" width="200" height="40" as="geometry" />
        </mxCell>
        <!-- POPUP OPEN -->
