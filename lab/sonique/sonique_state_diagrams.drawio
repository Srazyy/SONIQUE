        <mxCell id="s_perm" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;fontStyle=1;" value="REQUESTING&#xa;PERMISSIONS" vertex="1">
