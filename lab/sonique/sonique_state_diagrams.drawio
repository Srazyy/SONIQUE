        </mxCell>
        <!-- Initial -->
        <mxCell id="i2" value="" style="ellipse;html=1;shape=doubleCircle;whiteSpace=wrap;aspect=fixed;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="80" y="195" width="30" height="30" as="geometry" />
