        <mxCell id="s_rec_act" parent="1" style="text;html=0;fontSize=9;align=left;" value="entry / start MediaRecorder&#xa;entry / start waveform visualizer&#xa;do / capture audio chunks&#xa;do / display live waveform&#xa;do / acquire GPS coordinates" vertex="1">
          <mxGeometry height="60" width="200" x="825" y="182" as="geometry" />
        </mxCell>
        <mxCell id="s_upload" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;fontStyle=1;" value="UPLOADING" vertex="1">
          <mxGeometry height="60" width="170" x="820" y="340" as="geometry" />
        </mxCell>
        <mxCell id="s_upload_act" parent="1" style="text;html=0;fontSize=9;align=left;" value="entry / create FormData with audio blob&#xa;do / POST to /upload endpoint&#xa;do / show loading spinner" vertex="1">
          <mxGeometry height="40" width="220" x="825" y="402" as="geometry" />
        </mxCell>
        <mxCell id="s_conv" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;fontStyle=1;" value="CONVERTING" vertex="1">
          <mxGeometry height="60" width="170" x="500" y="340" as="geometry" />
        </mxCell>
        <mxCell id="s_conv_act" parent="1" style="text;html=0;fontSize=9;align=left;" value="entry / receive WebM audio&#xa;do / convert WebM → WAV (16kHz mono)&#xa;do / normalize waveform" vertex="1">
          <mxGeometry height="40" width="230" x="505" y="402" as="geometry" />
        </mxCell>
        <mxCell id="s_class" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;fontStyle=1;" value="CLASSIFYING" vertex="1">
          <mxGeometry height="60" width="170" x="200" y="340" as="geometry" />
        </mxCell>
        <mxCell id="s_class_act" parent="1" style="text;html=0;fontSize=9;align=left;" value="entry / load YAMNet model&#xa;do / run inference on waveform&#xa;do / extract top 3 predictions&#xa;do / map class indices to labels" vertex="1">
          <mxGeometry height="50" width="200" x="205" y="402" as="geometry" />
        </mxCell>
        <mxCell id="s_store" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;fontStyle=1;" value="STORING" vertex="1">
