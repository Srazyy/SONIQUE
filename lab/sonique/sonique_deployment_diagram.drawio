<mxfile host="app.diagrams.net">
  <diagram name="SONIQUE_Deployment_Diagram" id="sonique_deploy_01">
    <mxGraphModel dx="1600" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="SONIQUE — UML Deployment Diagram" style="text;html=1;fontSize=20;fontStyle=1;align=center;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="500" y="20" width="500" height="35" as="geometry" />
        </mxCell>

        <!-- ===== NODE: User Device ===== -->
        <mxCell id="node_user" value="&lt;&lt;device&gt;&gt;&#10;Client Device (PC/Mobile)" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;verticalAlign=top;spacingTop=15;" vertex="1" parent="1">
          <mxGeometry x="80" y="100" width="340" height="280" as="geometry" />
        </mxCell>

        <mxCell id="node_browser" value="&lt;&lt;execution environment&gt;&gt;&#10;Web Browser" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;fillColor=#FFFFFF;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;verticalAlign=top;spacingTop=15;" vertex="1" parent="node_user">
          <mxGeometry x="40" y="70" width="260" height="170" as="geometry" />
        </mxCell>

        <mxCell id="art_react" value="&lt;&lt;artifact&gt;&gt;&#10;React Frontend App&#10;(index.html, JS/CSS bundles)" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;" vertex="1" parent="node_user">
          <mxGeometry x="70" y="140" width="200" height="60" as="geometry" />
        </mxCell>

        <!-- ===== NODE: Docker Host / Server ===== -->
        <mxCell id="node_server" value="&lt;&lt;device&gt;&gt;&#10;Docker Host Server" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1;verticalAlign=top;spacingTop=15;" vertex="1" parent="1">
          <mxGeometry x="540" y="90" width="700" height="420" as="geometry" />
        </mxCell>

        <!-- Container: Nginx -->
        <mxCell id="node_nginx" value="&lt;&lt;execution environment&gt;&gt;&#10;Nginx Container (client)" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;fillColor=#FFFFFF;strokeColor=#82b366;fontSize=11;fontStyle=1;verticalAlign=top;spacingTop=15;" vertex="1" parent="node_server">
          <mxGeometry x="40" y="70" width="260" height="150" as="geometry" />
        </mxCell>

        <mxCell id="art_static" value="&lt;&lt;artifact&gt;&gt;&#10;Static Frontend Assets" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;" vertex="1" parent="node_server">
          <mxGeometry x="60" y="140" width="130" height="50" as="geometry" />
        </mxCell>

        <!-- Container: Flask -->
        <mxCell id="node_flask" value="&lt;&lt;execution environment&gt;&gt;&#10;Flask Container (server)" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;fillColor=#FFFFFF;strokeColor=#82b366;fontSize=11;fontStyle=1;verticalAlign=top;spacingTop=15;" vertex="1" parent="node_server">
          <mxGeometry x="380" y="70" width="280" height="200" as="geometry" />
        </mxCell>

        <mxCell id="art_api" value="&lt;&lt;artifact&gt;&gt;&#10;SONIQUE API (app.py)" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;" vertex="1" parent="node_server">
          <mxGeometry x="400" y="180" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="art_model" value="&lt;&lt;artifact&gt;&gt;&#10;YAMNet TensorFlow Model" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;" vertex="1" parent="node_server">
          <mxGeometry x="530" y="180" width="120" height="60" as="geometry" />
        </mxCell>

        <!-- Database Volume -->
        <mxCell id="node_volume" value="&lt;&lt;execution environment&gt;&gt;&#10;Docker Volume Mount (/app/sounds.db)" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1;verticalAlign=top;spacingTop=15;" vertex="1" parent="node_server">
          <mxGeometry x="380" y="300" width="280" height="100" as="geometry" />
        </mxCell>

        <mxCell id="art_db" value="&lt;&lt;artifact&gt;&gt;&#10;SQLite Database File" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;" vertex="1" parent="node_server">
          <mxGeometry x="450" y="330" width="140" height="50" as="geometry" />
        </mxCell>

        <!-- ===== EXTERNAL NODE: Tile Server ===== -->
        <mxCell id="node_osm" value="&lt;&lt;device&gt;&gt;&#10;OSM Tile Server" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;fontStyle=1;verticalAlign=top;spacingTop=15;" vertex="1" parent="1">
          <mxGeometry x="110" y="500" width="280" height="140" as="geometry" />
        </mxCell>

        <mxCell id="art_tiles" value="&lt;&lt;artifact&gt;&gt;&#10;Map Tiles (PNG/WebP)" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFFFFF;strokeColor=#666666;fontSize=10;" vertex="1" parent="node_osm">
          <mxGeometry x="70" y="70" width="140" height="50" as="geometry" />
        </mxCell>

        <!-- ===== CONNECTIONS (Communication Paths) ===== -->

        <!-- Client to Nginx -->
        <mxCell id="path_https" value="&lt;&lt;communication path&gt;&gt;&#10;HTTPS (Internet)" style="endArrow=none;html=1;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="node_user" target="node_nginx">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Nginx to Flask -->
        <mxCell id="path_docker" value="&lt;&lt;communication path&gt;&gt;&#10;HTTP (Internal Docker Network)" style="endArrow=none;html=1;strokeWidth=2;dashed=1;fontSize=11;" edge="1" parent="1" source="node_nginx" target="node_flask">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Flask to Volume -->
        <mxCell id="path_fs" value="&lt;&lt;communication path&gt;&gt;&#10;File System Access" style="endArrow=none;html=1;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="node_flask" target="node_volume">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Client to OSM -->
        <mxCell id="path_osm_https" value="&lt;&lt;communication path&gt;&gt;&#10;HTTPS (Internet)" style="endArrow=none;html=1;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="node_user" target="node_osm">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
