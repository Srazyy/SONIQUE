<mxfile host="app.diagrams.net">
  <diagram name="SONIQUE_Collaboration" id="sonique_collab_01">
    <mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="SONIQUE — Collaboration / Communication Diagram: Audio Classification" style="text;html=1;fontSize=16;fontStyle=1;align=center;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="250" y="10" width="700" height="30" as="geometry" />
        </mxCell>

        <!-- ===== OBJECTS ===== -->
        <mxCell id="o_user" value=":User" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="300" width="100" height="50" as="geometry" />
        </mxCell>

        <mxCell id="o_react" value=":React Frontend" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="340" y="150" width="140" height="50" as="geometry" />
        </mxCell>

        <mxCell id="o_browser" value=":Browser APIs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="340" y="470" width="130" height="50" as="geometry" />
        </mxCell>

        <mxCell id="o_flask" value=":Flask Backend" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="660" y="300" width="140" height="50" as="geometry" />
        </mxCell>

        <mxCell id="o_yamnet" value=":YAMNet Model" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1000" y="150" width="140" height="50" as="geometry" />
        </mxCell>

        <mxCell id="o_db" value=":SQLite DB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1000" y="470" width="130" height="50" as="geometry" />
        </mxCell>

        <mxCell id="o_osm" value=":OpenStreetMap" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="600" width="140" height="50" as="geometry" />
        </mxCell>

        <!-- ===== LINKS WITH NUMBERED MESSAGES ===== -->

        <!-- User ↔ React Frontend -->
        <mxCell id="l1" value="1: clickRecord()&#10;6: displayWaveform()&#10;17: displayMapWithMarker()" style="html=1;fontSize=9;endArrow=none;endFill=0;align=left;verticalAlign=top;" edge="1" parent="1">
          <mxGeometry x="-0.3" y="-5" relative="1" as="geometry">
            <mxPoint x="150" y="300" as="sourcePoint" />
            <mxPoint x="380" y="200" as="targetPoint" />
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>

        <!-- React Frontend ↔ Browser APIs -->
        <mxCell id="l2" value="2: requestMicrophoneAccess()&#10;3: return MediaStream&#10;4: getGeolocation()&#10;5: return {lat, lon}" style="html=1;fontSize=9;endArrow=none;endFill=0;align=right;verticalAlign=middle;" edge="1" parent="1">
          <mxGeometry x="-0.2" y="10" relative="1" as="geometry">
            <mxPoint x="410" y="200" as="sourcePoint" />
            <mxPoint x="410" y="470" as="targetPoint" />
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>

        <!-- React Frontend ↔ Flask Backend -->
        <mxCell id="l3" value="7: POST /upload(audio, lat, lon)&#10;14: return {label, confidence, top3}" style="html=1;fontSize=9;endArrow=none;endFill=0;verticalAlign=bottom;align=center;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="480" y="180" as="sourcePoint" />
            <mxPoint x="700" y="300" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Flask ↔ YAMNet -->
        <mxCell id="l4" value="8: convertToWAV()&#10;9: classify(waveform)&#10;10: return {scores}&#10;11: extractTop3()" style="html=1;fontSize=9;endArrow=none;endFill=0;verticalAlign=bottom;align=center;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="800" y="310" as="sourcePoint" />
            <mxPoint x="1050" y="200" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Flask ↔ SQLite DB -->
        <mxCell id="l5" value="12: INSERT(label, confidence, lat, lon)&#10;13: return recordId" style="html=1;fontSize=9;endArrow=none;endFill=0;verticalAlign=middle;align=center;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="800" y="340" as="sourcePoint" />
            <mxPoint x="1050" y="470" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- React Frontend ↔ OpenStreetMap -->
        <mxCell id="l6" value="15: requestTiles(lat, lon, zoom)&#10;16: return mapTileImages" style="html=1;fontSize=9;endArrow=none;endFill=0;verticalAlign=middle;align=left;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="340" y="200" as="sourcePoint" />
            <mxPoint x="150" y="600" as="targetPoint" />
          </mxGeometry>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
