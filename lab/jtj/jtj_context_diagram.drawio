<mxfile host="app.diagrams.net">
  <diagram name="JTJ_Context_Diagram" id="jtj_context_01">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="Just The Job (JTJ) — Context Diagram (Level-0 DFD)" style="text;html=1;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="250" y="20" width="550" height="40" as="geometry" />
        </mxCell>

        <!-- Central Process -->
        <mxCell id="process0" value="0&#10;&#10;JTJ&#10;Cleaning Management&#10;System" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="400" y="280" width="220" height="170" as="geometry" />
        </mxCell>

        <!-- External Entity: Customer -->
        <mxCell id="ext_cust" value="Customer" style="shape=rectangle;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="180" width="150" height="50" as="geometry" />
        </mxCell>

        <!-- External Entity: Cleaners -->
        <mxCell id="ext_clean" value="Cleaners" style="shape=rectangle;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="500" width="150" height="50" as="geometry" />
        </mxCell>

        <!-- External Entity: Office Manager -->
        <mxCell id="ext_mgr" value="Office Manager&#10;(Eileen)" style="shape=rectangle;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="830" y="180" width="150" height="50" as="geometry" />
        </mxCell>

        <!-- External Entity: Receptionist -->
        <mxCell id="ext_recep" value="Receptionist" style="shape=rectangle;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="830" y="500" width="150" height="50" as="geometry" />
        </mxCell>

        <!-- Data Flows: Customer ↔ System -->
        <mxCell id="df1" value="Booking Request,&#10;Signed Booking Form,&#10;Payment" style="html=1;fontSize=10;" edge="1" parent="1" source="ext_cust" target="process0">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="df2" value="Booking Form Copy,&#10;Invoice,&#10;Receipted Invoice" style="html=1;fontSize=10;" edge="1" parent="1" source="process0" target="ext_cust">
          <mxGeometry x="-0.1" y="30" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <!-- Data Flows: Cleaners ↔ System -->
        <mxCell id="df3" value="Signed Booking Form,&#10;Hours Worked" style="html=1;fontSize=10;" edge="1" parent="1" source="ext_clean" target="process0">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="df4" value="Weekly Schedule,&#10;Booking Form,&#10;Job Details" style="html=1;fontSize=10;" edge="1" parent="1" source="process0" target="ext_clean">
          <mxGeometry x="-0.1" y="30" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <!-- Data Flows: Office Manager ↔ System -->
        <mxCell id="df5" value="Property Visit Report,&#10;Date &amp; Price Estimate,&#10;Cleaner Assignment" style="html=1;fontSize=10;" edge="1" parent="1" source="ext_mgr" target="process0">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="df6" value="Appointment Schedule,&#10;Weekly Hours List" style="html=1;fontSize=10;" edge="1" parent="1" source="process0" target="ext_mgr">
          <mxGeometry x="-0.1" y="30" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <!-- Data Flows: Receptionist ↔ System -->
        <mxCell id="df7" value="Booking Details,&#10;Payment Received" style="html=1;fontSize=10;" edge="1" parent="1" source="ext_recep" target="process0">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="df8" value="Invoice to Print,&#10;Receipted Invoice,&#10;Customer Details" style="html=1;fontSize=10;" edge="1" parent="1" source="process0" target="ext_recep">
          <mxGeometry x="-0.1" y="30" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
