<mxfile host="app.diagrams.net">
  <diagram name="JTJ_Deployment_Diagram" id="jtj_deploy_01">
    <mxGraphModel dx="1600" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="JTJ — UML Deployment Diagram" style="text;html=1;fontSize=20;fontStyle=1;align=center;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="450" y="20" width="500" height="35" as="geometry" />
        </mxCell>

        <!-- ===== NODE: Main Office ===== -->
        <mxCell id="node_office" value="&lt;&lt;physical location&gt;&gt;&#10;JTJ Main Office" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;verticalAlign=top;spacingTop=15;" vertex="1" parent="1">
          <mxGeometry x="60" y="100" width="600" height="420" as="geometry" />
        </mxCell>

        <!-- Node: Front Desk -->
        <mxCell id="node_reception" value="&lt;&lt;workstation&gt;&gt;&#10;Front Desk" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;fillColor=#FFFFFF;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;verticalAlign=top;spacingTop=15;" vertex="1" parent="node_office">
          <mxGeometry x="30" y="70" width="220" height="150" as="geometry" />
        </mxCell>

        <mxCell id="art_phone" value="&lt;&lt;device&gt;&gt;&#10;Telephone" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;" vertex="1" parent="node_office">
          <mxGeometry x="50" y="130" width="80" height="50" as="geometry" />
        </mxCell>
        <mxCell id="art_diary" value="&lt;&lt;artifact&gt;&gt;&#10;Booking Diary" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;" vertex="1" parent="node_office">
          <mxGeometry x="150" y="130" width="80" height="50" as="geometry" />
        </mxCell>

        <!-- Node: Filing Room -->
        <mxCell id="node_filing" value="&lt;&lt;storage facility&gt;&gt;&#10;Filing System" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;fillColor=#FFFFFF;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;verticalAlign=top;spacingTop=15;" vertex="1" parent="node_office">
          <mxGeometry x="30" y="240" width="540" height="150" as="geometry" />
        </mxCell>

        <mxCell id="art_custfile" value="&lt;&lt;artifact&gt;&gt;&#10;Customer Files" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="node_office">
          <mxGeometry x="60" y="300" width="100" height="60" as="geometry" />
        </mxCell>
        <mxCell id="art_jobfile" value="&lt;&lt;artifact&gt;&gt;&#10;Job/Booking Forms&#10;(2 copies)" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="node_office">
          <mxGeometry x="200" y="300" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="art_invfile" value="&lt;&lt;artifact&gt;&gt;&#10;Invoice Ledger" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="node_office">
          <mxGeometry x="360" y="300" width="100" height="60" as="geometry" />
        </mxCell>

        <!-- Node: Accounts Desk -->
        <mxCell id="node_accounts" value="&lt;&lt;workstation&gt;&gt;&#10;Accounts Desk" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;fillColor=#FFFFFF;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;verticalAlign=top;spacingTop=15;" vertex="1" parent="node_office">
          <mxGeometry x="350" y="70" width="220" height="150" as="geometry" />
        </mxCell>

        <mxCell id="art_invgen" value="&lt;&lt;artifact&gt;&gt;&#10;Invoice Forms" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;" vertex="1" parent="node_office">
          <mxGeometry x="410" y="130" width="100" height="50" as="geometry" />
        </mxCell>

        <!-- ===== NODE: Customer Premises ===== -->
        <mxCell id="node_cust" value="&lt;&lt;physical location&gt;&gt;&#10;Customer Premises" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1;verticalAlign=top;spacingTop=15;" vertex="1" parent="1">
          <mxGeometry x="960" y="110" width="300" height="280" as="geometry" />
        </mxCell>

        <mxCell id="node_cust_file" value="&lt;&lt;storage&gt;&gt;&#10;Customer Records" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;fillColor=#FFFFFF;strokeColor=#82b366;fontSize=11;fontStyle=1;verticalAlign=top;spacingTop=15;" vertex="1" parent="node_cust">
          <mxGeometry x="40" y="80" width="220" height="160" as="geometry" />
        </mxCell>

        <mxCell id="art_cust_booking" value="&lt;&lt;artifact&gt;&gt;&#10;Booking Form&#10;(Customer Copy)" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;" vertex="1" parent="node_cust">
          <mxGeometry x="60" y="140" width="80" height="60" as="geometry" />
        </mxCell>
        <mxCell id="art_cust_inv" value="&lt;&lt;artifact&gt;&gt;&#10;Received Invoice" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;" vertex="1" parent="node_cust">
          <mxGeometry x="160" y="140" width="80" height="60" as="geometry" />
        </mxCell>

        <!-- ===== NODE: Cleaning Vehicle ===== -->
        <mxCell id="node_vehicle" value="&lt;&lt;mobile unit&gt;&gt;&#10;Cleaner Vehicle" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;fontStyle=1;verticalAlign=top;spacingTop=15;" vertex="1" parent="1">
          <mxGeometry x="410" y="600" width="280" height="220" as="geometry" />
        </mxCell>

        <mxCell id="node_clipboard" value="&lt;&lt;device&gt;&gt;&#10;Job Clipboard" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;fillColor=#FFFFFF;strokeColor=#9673a6;fontSize=11;fontStyle=1;verticalAlign=top;spacingTop=15;" vertex="1" parent="node_vehicle">
          <mxGeometry x="30" y="70" width="220" height="120" as="geometry" />
        </mxCell>

        <mxCell id="art_active_job" value="&lt;&lt;artifact&gt;&gt;&#10;Booking Form&#10;(Office Copy 1)" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;" vertex="1" parent="node_vehicle">
          <mxGeometry x="50" y="120" width="80" height="50" as="geometry" />
        </mxCell>
        <mxCell id="art_week_sched" value="&lt;&lt;artifact&gt;&gt;&#10;Weekly Schedule" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;" vertex="1" parent="node_vehicle">
          <mxGeometry x="150" y="120" width="80" height="50" as="geometry" />
        </mxCell>

        <!-- ===== CONNECTIONS (Communication Paths) ===== -->

        <!-- Office to Customer (Phone) -->
        <mxCell id="path_phone" value="&lt;&lt;communication path&gt;&gt;&#10;Telephone Line" style="endArrow=none;html=1;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="node_reception" target="node_cust">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
               <mxPoint x="800" y="245" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Office to Customer (Postal) -->
        <mxCell id="path_post" value="&lt;&lt;communication path&gt;&gt;&#10;Postal Service (Invoices)" style="endArrow=none;html=1;strokeWidth=2;dashed=1;fontSize=11;" edge="1" parent="1" source="node_accounts" target="node_cust">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
               <mxPoint x="800" y="140" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Office to Vehicle (Physical) -->
        <mxCell id="path_dispatch" value="&lt;&lt;communication path&gt;&gt;&#10;Physical Handover (Dispatch)" style="endArrow=none;html=1;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="node_office" target="node_vehicle">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Vehicle to Customer (Physical Transport) -->
        <mxCell id="path_drive" value="&lt;&lt;communication path&gt;&gt;&#10;Physical Transport (Road)" style="endArrow=none;html=1;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="node_vehicle" target="node_cust">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
               <mxPoint x="1110" y="710" />
            </Array>
          </mxGeometry>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
