<mxfile host="app.diagrams.net">
  <diagram name="JTJ_Seq_OneOff_Job" id="jtj_seq_oneoff">
    <mxGraphModel dx="1400" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="JTJ — Sequence Diagram: One-Off Job Process" style="text;html=1;fontSize=16;fontStyle=1;align=center;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="300" y="10" width="500" height="30" as="geometry" />
        </mxCell>

        <!-- ===== ACTOR / OBJECT LIFELINES ===== -->

        <!-- Customer -->
        <mxCell id="obj_cust" value=":Customer" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;size=40;" vertex="1" parent="1">
          <mxGeometry x="60" y="60" width="100" height="1080" as="geometry" />
        </mxCell>

        <!-- Receptionist -->
        <mxCell id="obj_recep" value=":Receptionist" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;size=40;" vertex="1" parent="1">
          <mxGeometry x="260" y="60" width="110" height="1080" as="geometry" />
        </mxCell>

        <!-- Office Manager -->
        <mxCell id="obj_mgr" value=":Office Manager&#10;(Eileen)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontStyle=1;size=40;" vertex="1" parent="1">
          <mxGeometry x="470" y="60" width="120" height="1080" as="geometry" />
        </mxCell>

        <!-- Booking File -->
        <mxCell id="obj_book" value=":BookingFile" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;size=40;" vertex="1" parent="1">
          <mxGeometry x="680" y="60" width="100" height="1080" as="geometry" />
        </mxCell>

        <!-- Cleaners -->
        <mxCell id="obj_clean" value=":Cleaners" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontStyle=1;size=40;" vertex="1" parent="1">
          <mxGeometry x="880" y="60" width="100" height="1080" as="geometry" />
        </mxCell>

        <!-- Invoice File -->
        <mxCell id="obj_inv" value=":InvoiceFile" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;size=40;" vertex="1" parent="1">
          <mxGeometry x="1080" y="60" width="100" height="1080" as="geometry" />
        </mxCell>

        <!-- ===== MESSAGES ===== -->

        <!-- 1. Customer → Receptionist: Request Booking -->
        <mxCell id="m1" value="1: requestBooking(name, address, phone)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="110" y="140" as="sourcePoint" />
            <mxPoint x="310" y="140" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- 2. Receptionist → Office Manager: Schedule Visit -->
        <mxCell id="m2" value="2: schedulePropertyVisit(customerDetails, address)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="315" y="200" as="sourcePoint" />
            <mxPoint x="525" y="200" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- 3. Office Manager → Customer: Visit & Estimate -->
        <mxCell id="m3" value="3: visitProperty(date, price)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="525" y="260" as="sourcePoint" />
            <mxPoint x="110" y="260" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- 4. Customer → Office Manager: Agree Terms -->
        <mxCell id="m4" value="4: agreeTerms(date, price)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="110" y="320" as="sourcePoint" />
            <mxPoint x="525" y="320" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- 5. Office Manager → BookingFile: Create Booking -->
        <mxCell id="m5" value="5: createBooking(customerNo, address, date, price)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="530" y="380" as="sourcePoint" />
            <mxPoint x="725" y="380" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- 6. BookingFile → Customer: Copy of Booking Form -->
        <mxCell id="m6" value="6: return bookingFormCopy" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="725" y="430" as="sourcePoint" />
            <mxPoint x="110" y="430" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- 7. Office Manager → Cleaners: Assign Job -->
        <mxCell id="m7" value="7: assignJob(bookingNo, address, date, team)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="530" y="500" as="sourcePoint" />
            <mxPoint x="925" y="500" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- 8. Cleaners → Cleaners: Carry Out Cleaning -->
        <mxCell id="m8" value="8: carryOutCleaning()" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="930" y="560" as="sourcePoint" />
            <mxPoint x="990" y="560" as="targetPoint" />
            <Array as="points">
              <mxPoint x="990" y="560" />
              <mxPoint x="990" y="590" />
              <mxPoint x="930" y="590" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- 9. Cleaners → Customer: Request Signature -->
        <mxCell id="m9" value="9: requestSignature(bookingForm)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="925" y="640" as="sourcePoint" />
            <mxPoint x="110" y="640" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- 10. Customer → Cleaners: Sign Form -->
        <mxCell id="m10" value="10: return signedBookingForm" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="110" y="700" as="sourcePoint" />
            <mxPoint x="925" y="700" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- 11. Cleaners → Receptionist: Return Signed Form -->
        <mxCell id="m11" value="11: returnSignedForm(bookingNo, signature)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="925" y="760" as="sourcePoint" />
            <mxPoint x="315" y="760" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- 12. Receptionist → BookingFile: Update Status -->
        <mxCell id="m12" value="12: updateStatus(bookingNo, COMPLETED)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="320" y="820" as="sourcePoint" />
            <mxPoint x="725" y="820" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- 13. Receptionist → InvoiceFile: Generate Invoice -->
        <mxCell id="m13" value="13: generateInvoice(bookingNo, customerNo, amount)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="320" y="880" as="sourcePoint" />
            <mxPoint x="1125" y="880" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- 14. Receptionist → Customer: Send Invoice -->
        <mxCell id="m14" value="14: sendInvoice(invoiceNo, amount)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="310" y="940" as="sourcePoint" />
            <mxPoint x="110" y="940" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- 15. Customer → Receptionist: Submit Payment -->
        <mxCell id="m15" value="15: submitPayment(invoiceNo, amount)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="110" y="1000" as="sourcePoint" />
            <mxPoint x="315" y="1000" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- 16. Receptionist → InvoiceFile: Mark Paid -->
        <mxCell id="m16" value="16: markPaid(invoiceNo)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="320" y="1050" as="sourcePoint" />
            <mxPoint x="1125" y="1050" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- 17. Receptionist → Customer: Send Receipt -->
        <mxCell id="m17" value="17: sendReceiptedInvoice(invoiceNo)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="310" y="1100" as="sourcePoint" />
            <mxPoint x="110" y="1100" as="targetPoint" />
          </mxGeometry>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>

  <diagram name="JTJ_Seq_Regular_Job" id="jtj_seq_regular">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title2" value="JTJ — Sequence Diagram: Regular Weekly Cleaning" style="text;html=1;fontSize=16;fontStyle=1;align=center;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="250" y="10" width="500" height="30" as="geometry" />
        </mxCell>

        <!-- Lifelines -->
        <mxCell id="r_cust" value=":Customer" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;size=40;" vertex="1" parent="1">
          <mxGeometry x="50" y="60" width="100" height="780" as="geometry" />
        </mxCell>

        <mxCell id="r_mgr" value=":Office Manager" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontStyle=1;size=40;" vertex="1" parent="1">
          <mxGeometry x="240" y="60" width="120" height="780" as="geometry" />
        </mxCell>

        <mxCell id="r_sys" value=":JTJ System" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;size=40;" vertex="1" parent="1">
          <mxGeometry x="450" y="60" width="100" height="780" as="geometry" />
        </mxCell>

        <mxCell id="r_clean" value=":Cleaner" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontStyle=1;size=40;" vertex="1" parent="1">
          <mxGeometry x="650" y="60" width="100" height="780" as="geometry" />
        </mxCell>

        <mxCell id="r_recep" value=":Receptionist" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;size=40;" vertex="1" parent="1">
          <mxGeometry x="850" y="60" width="110" height="780" as="geometry" />
        </mxCell>

        <!-- Messages -->
        <mxCell id="rm1" value="1: negotiateRate(hourlyRate, day)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="100" y="150" as="sourcePoint" />
            <mxPoint x="295" y="150" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="rm2" value="2: createRegularBooking(customer, rate, day)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="300" y="210" as="sourcePoint" />
            <mxPoint x="495" y="210" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="rm3" value="3: assignCleaner(bookingNo, cleanerID)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="300" y="270" as="sourcePoint" />
            <mxPoint x="495" y="270" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Loop fragment -->
        <mxCell id="loop" value="loop [every week]" style="shape=umlFrame;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;fontSize=11;fontStyle=1;width=120;height=20;" vertex="1" parent="1">
          <mxGeometry x="30" y="320" width="940" height="260" as="geometry" />
        </mxCell>

        <mxCell id="rm4" value="4: generateWeeklySchedule(cleanerID)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="500" y="370" as="sourcePoint" />
            <mxPoint x="695" y="370" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="rm5" value="5: performCleaning(address)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="700" y="430" as="sourcePoint" />
            <mxPoint x="100" y="430" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="rm6" value="6: recordHours(cleanerID, hours)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="700" y="490" as="sourcePoint" />
            <mxPoint x="500" y="490" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="rm7" value="7: produceWeeklyHoursList()" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="500" y="540" as="sourcePoint" />
            <mxPoint x="300" y="540" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- End loop, monthly invoice -->
        <mxCell id="loop2" value="loop [every month]" style="shape=umlFrame;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#b85450;fontSize=11;fontStyle=1;width=130;height=20;" vertex="1" parent="1">
          <mxGeometry x="30" y="620" width="940" height="180" as="geometry" />
        </mxCell>

        <mxCell id="rm8" value="8: generateMonthlyInvoice(customerNo)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="500" y="680" as="sourcePoint" />
            <mxPoint x="900" y="680" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="rm9" value="9: sendInvoice(customer, totalAmount)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="900" y="740" as="sourcePoint" />
            <mxPoint x="100" y="740" as="targetPoint" />
          </mxGeometry>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
