<mxfile host="app.diagrams.net">
  <diagram name="SONIQUE_Context_Diagram" id="sonique_context_01">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="SONIQUE — Context Diagram (Level-0 DFD)" style="text;html=1;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="280" y="20" width="500" height="40" as="geometry" />
        </mxCell>

        <!-- Central Process: SONIQUE System -->
        <mxCell id="process0" value="0&#10;&#10;SONIQUE&#10;Urban Sound&#10;Classification System" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="400" y="300" width="200" height="160" as="geometry" />
        </mxCell>

        <!-- External Entity: User -->
        <mxCell id="ext_user" value="User&#10;(Urban Planner /&#10;Researcher / Citizen)" style="shape=rectangle;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="200" width="160" height="70" as="geometry" />
        </mxCell>

        <!-- External Entity: Browser -->
        <mxCell id="ext_browser" value="Web Browser&#10;(Microphone &amp;&#10;Geolocation APIs)" style="shape=rectangle;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="450" width="160" height="70" as="geometry" />
        </mxCell>

        <!-- External Entity: YAMNet Model -->
        <mxCell id="ext_yamnet" value="YAMNet ML Model&#10;(TensorFlow Hub)" style="shape=rectangle;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="780" y="200" width="160" height="60" as="geometry" />
        </mxCell>

        <!-- External Entity: OpenStreetMap -->
        <mxCell id="ext_osm" value="OpenStreetMap&#10;(Tile Server)" style="shape=rectangle;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="780" y="450" width="160" height="60" as="geometry" />
        </mxCell>

        <!-- Data Flows: User ↔ System -->
        <mxCell id="df1" value="Audio Recording,&#10;Location Permissions" style="html=1;fontSize=10;" edge="1" parent="1" source="ext_user" target="process0">
          <mxGeometry relative="1" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="df2" value="Classification Results,&#10;Map Visualisation,&#10;Sound History" style="html=1;fontSize=10;" edge="1" parent="1" source="process0" target="ext_user">
          <mxGeometry x="-0.1" y="30" relative="1" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>

        <!-- Data Flows: Browser ↔ System -->
        <mxCell id="df3" value="Microphone Stream,&#10;GPS Coordinates" style="html=1;fontSize=10;" edge="1" parent="1" source="ext_browser" target="process0">
          <mxGeometry relative="1" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>

        <!-- Data Flows: System ↔ YAMNet -->
        <mxCell id="df4" value="WAV Audio File" style="html=1;fontSize=10;" edge="1" parent="1" source="process0" target="ext_yamnet">
          <mxGeometry relative="1" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="df5" value="Top-3 Predictions&#10;(Label + Confidence)" style="html=1;fontSize=10;" edge="1" parent="1" source="ext_yamnet" target="process0">
          <mxGeometry x="-0.1" y="25" relative="1" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>

        <!-- Data Flows: System ↔ OpenStreetMap -->
        <mxCell id="df6" value="Tile Requests&#10;(lat, lon, zoom)" style="html=1;fontSize=10;" edge="1" parent="1" source="process0" target="ext_osm">
          <mxGeometry relative="1" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="df7" value="Map Tile Images" style="html=1;fontSize=10;" edge="1" parent="1" source="ext_osm" target="process0">
          <mxGeometry x="-0.1" y="25" relative="1" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
